SWARMMIND_ENV=development
SWARMMIND_SIM_DB=/Users/you/Downloads/swarmmind/simulation_state.db
SWARMMIND_STRICT_STARTUP=false
SWARMMIND_ALLOW_SQLITE_IN_PRODUCTION=false

# Auth modes: disabled, api_key, bearer
SWARMMIND_AUTH_MODE=disabled
SWARMMIND_ALLOW_INSECURE_LOCALHOST=true
SWARMMIND_API_KEY=replace-me-for-api-key-mode
SWARMMIND_BEARER_ISSUER=https://issuer.example.com/
SWARMMIND_BEARER_AUDIENCE=swarmmind-api
SWARMMIND_BEARER_SECRET=replace-me-for-hs256
SWARMMIND_BEARER_ALGORITHMS=HS256

# Future external integrations
SWARMMIND_DATABASE_URL=
SWARMMIND_MAPBOX_PUBLIC_TOKEN=
SWARMMIND_MAPBOX_STYLE=mapbox://styles/mapbox/dark-v11
SWARMMIND_WZDX_FEED_URL=
OPENCELLID_API_KEY=
SWARMMIND_LABELED_EVENTS_MANIFEST=/Users/you/Downloads/swarmmind/external_data/labeled_events/manifest.json
